{
  "rules": {
    ".read": false,
    ".write": false,

    "students": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "faces": {
      ".read": false,
      ".write": false
    },

    "attendance": {
      "$date": {
        ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
          ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        "$nisn": {
          ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
        }
      }
    },

    "attendance_by_student": {
      "$nisn": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('parent_links').child(root.child('parent_uid_index').child(auth.uid).val()).child('nisn').val() == $nisn)",
        
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },

    "registration_sessions": {
      "$session_id": {
        ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".write": false
      }
    },

    "command": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "devices": {
      "$device_id": {
        "status": {
          ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
          ".write": true
        }
      }
    },

    "settings": {
      "recognition": {
        ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      },
      "attendance": {
        ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },

    "classes": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "parent_links": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$token": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        "uid": {
          ".write": "auth != null && newData.val() == auth.uid"
        }
      }
    },

    "parent_uid_index": {
      "$uid": {
        ".read": false,
        ".write": "auth != null && auth.uid == $uid && root.child('parent_links').child(newData.val()).exists()"
      }
    },

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": false
    },

    "_connection_test": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    }
  }
}